{
  "expo": {
    "name": "Attendance Management System",
    "slug": "client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/university-logo.png",
    "scheme": "client",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.susl.attendance"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/university-logo.png",
        "backgroundColor": "#e8ede8"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.susl.attendance",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "client"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#e8ede8"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Attendance System to access your camera for face verification."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Attendance System to use your location to verify you are in the lecture hall."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-barcode-scanner"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
